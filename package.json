{
  "name": "espresso-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "lint": "tsc --noEmit",
    "pretest": "node scripts/package-test-contract.test.mjs",
    "test:unit": "vitest run",
    "test": "npm run test:unit && npm run test:e2e:runner",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "sh scripts/run-e2e.sh",
    "test:e2e:runner": "node scripts/e2e-runner.test.mjs"
  },
  "dependencies": {
    "expo": "~56.0.15",
    "expo-constants": "~56.0.20",
    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.15",
    "expo-router": "~56.2.14",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "lucide-react-native": "^1.21.0",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "serve": "^14.2.6",
    "typescript": "~6.0.3",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "uuid": "11.1.1"
  }
}
